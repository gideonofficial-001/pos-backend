generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  OVERALL_MANAGER
  BRANCH_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductType {
  LPG_REFILL
  LPG_CYLINDER
  ELECTRONICS
  ACCESSORIES
}

enum SaleType {
  CASH
  INVOICE
}

enum SaleStatus {
  PENDING
  COMPLETED
  RETURNED
  CANCELLED
}

// NEW ENUM: Tracks exactly what type of LPG transaction occurred
enum LpgSaleVariant {
  REFILL
  EMPTY_SHELL
  COMPLETE_SET
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum AuditAction {
  LOGIN
  LOGOUT
  SALE_CREATED
  SALE_COMPLETED
  SALE_RETURNED
  INVOICE_CREATED
  INVOICE_PAID
  STOCK_ADJUSTED
  STOCK_RESTOCKED
  DEVICE_REGISTERED
  DEVICE_APPROVED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  BRANCH_CREATED
  BRANCH_UPDATED
}

enum ExpenseCategory {
  FUEL
  UTILITIES
  REPAIRS
  MISCELLANEOUS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum NotificationType {
  DEVICE_AUTH
  RETURN_REQUEST
  INVOICE_CREATED
  TRANSFER_REQUEST
  EXPENSE_SUBMITTED
  TRANSFER_APPROVED
  TRANSFER_REJECTED
  RETURN_APPROVED
  RETURN_REJECTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  LOW_STOCK
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum PaymentProvider {
  CASH
  MPESA
  BANK
}

enum MovementType {
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  RESTOCK
  ADJUSTMENT
  OPENING
}

enum ActivityActor {
  USER
  SYSTEM
}

// ==================== MODELS ====================

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole
  status    UserStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation("BranchUsers", fields: [branchId], references: [id])
  managedBranch Branch? @relation("BranchManager")

  lastLoginAt DateTime?

  devices              Device[]
  sales                Sale[]
  invoices             Invoice[]
  returns              Return[]
  auditLogs            AuditLog[]
  expenses             Expense[]
  transfersInitiated   Transfer[]           @relation("InitiatedBy")
  transfersApproved    Transfer[]           @relation("TransferApprovedBy")
  approvedDevices      Device[]             @relation("ApprovedBy")
  approvedReturns      Return[]             @relation("ReturnApprovedBy")
  approvedExpenses     Expense[]            @relation("ExpenseApprovedBy")
  refillVerifications  RefillVerification[] @relation("RefillVerifiedBy")
  notifications        Notification[]       @relation("UserNotifications")
  stockAdjustments     StockAdjustment[]
  stockMovements       StockMovement[]
  branchClosings       BranchClosing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Device {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprint    String
  deviceInfo     String
  ipAddress      String
  status         DeviceStatus @default(PENDING)

  approvedById   String?
  approvedBy     User?        @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  authCodeHash   String?
  authCodeExpiry DateTime?

  lastUsedAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  @@unique([userId, fingerprint])
  @@map("devices")
}

model Branch {
  id        String  @id @default(uuid())
  name      String
  code      String  @unique
  address   String
  phone     String
  email     String?

  managerId String? @unique
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id])

  users                User[]               @relation("BranchUsers")
  inventory            Inventory[]
  sales                Sale[]
  invoices             Invoice[]
  expenses             Expense[]
  transfersFrom        Transfer[]           @relation("TransferFromBranch")
  transfersTo          Transfer[]           @relation("TransferToBranch")
  dailySummaries       DailySalesSummary[]
  refillVerifications  RefillVerification[]
  branchClosings       BranchClosing[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product_categories")
}

model Product {
  id                String           @id @default(uuid())
  name              String
  code              String           @unique
  description       String?
  type              ProductType

  categoryId        String?
  category          ProductCategory? @relation(fields: [categoryId], references: [id])

  price             Decimal          @db.Decimal(10, 2)
  emptyPrice        Decimal?         @db.Decimal(10, 2) // NEW FIELD: Price for selling empty shells
  costPrice         Decimal?         @db.Decimal(10, 2)

  cylinderSize      String?
  brand             String?
  isCylinderTracked Boolean          @default(false)

  minStockLevel     Int              @default(10)

  inventory     Inventory[]
  saleItems     SaleItem[]
  transferItems TransferItem[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Inventory {
  id        String @id @default(uuid())

  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity       Int  @default(0)
  fullCylinders  Int?
  minimumQuantity Int @default(10)

  totalRefilled Int  @default(0)
  totalSold     Int  @default(0)

  lastRestocked DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockAdjustments StockAdjustment[]
  transferItems    TransferItem[]
  stockMovements   StockMovement[]

  @@unique([branchId, productId])
  @@map("inventory")
}

model Customer {
  id                 String  @id @default(uuid())
  customerCode       String  @unique
  fullName           String
  phone              String  @unique
  email              String? @unique
  businessName       String?
  address            String?
  creditLimit        Decimal @db.Decimal(10, 2) @default(0)
  outstandingBalance Decimal @db.Decimal(10, 2) @default(0)
  isActive           Boolean @default(true)
  isInvoiceEligible  Boolean @default(true)

  invoices Invoice[]
  sales    Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Sale {
  id       String @id @default(uuid())
  saleCode String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  type   SaleType
  status SaleStatus @default(COMPLETED)

  customerName  String?
  customerPhone String?

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @db.Decimal(10, 2) @default(0)
  discount Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)

  invoiceId        String?          @unique
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])

  paymentReference String?          @unique
  paymentProvider  PaymentProvider?

  saleDate DateTime @default(now())

  items   SaleItem[]
  returns Return[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  isRefill   Boolean @default(false)
  lpgVariant LpgSaleVariant? // NEW FIELD: Tracks REFILL, EMPTY_SHELL, or COMPLETE_SET

  createdAt DateTime @default(now())

  @@map("sale_items")
}

model Invoice {
  id          String @id @default(uuid())
  invoiceCode String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?

  amount  Decimal       @db.Decimal(10, 2)
  status  InvoiceStatus @default(PENDING)
  dueDate DateTime

  smsSent   Boolean   @default(false)
  smsSentAt DateTime?

  sale Sale?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model Return {
  id         String @id @default(uuid())
  returnCode String @unique

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reason String
  amount Decimal @db.Decimal(10, 2)
  status ReturnStatus @default(PENDING)

  approvedById    String?
  approvedBy      User?    @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  stockReversed Boolean @default(false)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("returns")
}

model Expense {
  id          String @id @default(uuid())
  expenseCode String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  description String

  receiptUrl String?

  status          ExpenseStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?         @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model Transfer {
  id           String @id @default(uuid())
  transferCode String @unique

  fromBranchId String
  fromBranch   Branch @relation("TransferFromBranch", fields: [fromBranchId], references: [id])

  toBranchId String
  toBranch   Branch @relation("TransferToBranch", fields: [toBranchId], references: [id])

  initiatedBy String
  initiator   User   @relation("InitiatedBy", fields: [initiatedBy], references: [id])

  approvedById String?
  approvedBy   User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  status          TransferStatus @default(PENDING)
  notes           String?
  rejectionReason String?

  items TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transfers")
}

model TransferItem {
  id String @id @default(uuid())

  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  quantity Int

  createdAt DateTime @default(now())

  @@map("transfer_items")
}

model RefillVerification {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  expectedQuantity Int
  actualQuantity   Int
  verifiedQuantity Int?
  variance         Int @default(0)

  verifiedById String?
  verifiedBy   User?   @relation("RefillVerifiedBy", fields: [verifiedById], references: [id])

  notes      String?
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@map("refill_verifications")
}

model StockMovement {
  id String @id @default(uuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  productId String
  branchId  String

  quantityBefore  Int
  quantityChanged Int
  quantityAfter   Int

  movementType MovementType

  referenceId   String?
  referenceType String?

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([branchId])
  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

model BranchClosing {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  closingDate DateTime

  expectedCash Decimal @db.Decimal(10, 2)
  actualCash   Decimal @db.Decimal(10, 2)
  variance     Decimal @db.Decimal(10, 2)

  totalSales    Int
  totalRevenue  Decimal @db.Decimal(10, 2)
  totalExpenses Decimal @db.Decimal(10, 2) @default(0)
  netAmount     Decimal @db.Decimal(10, 2)

  submittedById String?
  submittedBy   User?   @relation(fields: [submittedById], references: [id])

  summarySmsSent   Boolean   @default(false)
  summarySmsSentAt DateTime?

  notes     String?
  createdAt DateTime @default(now())

  @@unique([branchId, closingDate])
  @@index([closingDate])
  @@map("branch_closings")
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  description String?
  isPublic    Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}

model ActivityFeed {
  id String @id @default(uuid())

  actorId   String?
  actorType ActivityActor @default(USER)
  actorName String?

  branchId   String?
  branchName String?

  title   String
  message String

  entityId   String?
  entityType String?
  actionUrl  String?

  visibleToAdmin   Boolean @default(true)
  visibleToManager Boolean @default(false)
  visibleToBranch  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([createdAt])
  @@index([entityType])
  @@map("activity_feed")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  entityType String
  entityId   String?

  oldValues   Json?
  newValues   Json?
  description String

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  actionUrl String?

  userId String?
  user   User?   @relation("UserNotifications", fields: [userId], references: [id])

  entityId   String?
  entityType String?

  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model StockAdjustment {
  id String @id @default(uuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  type     String
  quantity Int
  reason   String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  performedAt DateTime @default(now())

  notes     String?
  createdAt DateTime @default(now())

  @@map("stock_adjustments")
}

model DailySalesSummary {
  id String @id @default(uuid())

  date DateTime

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  totalSales   Int
  totalAmount  Decimal @db.Decimal(10, 2)
  cashSales    Int
  invoiceSales Int

  lpgRefills   Int
  lpgCylinders Int
  electronics  Int

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([date, branchId])
  @@map("daily_sales_summaries")
}
