generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  OVERALL_MANAGER
  BRANCH_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductType {
  LPG_REFILL
  LPG_CYLINDER
  ELECTRONICS
  ACCESSORIES
}

enum SaleType {
  CASH
  INVOICE
}

enum SaleStatus {
  PENDING
  COMPLETED
  RETURNED
  CANCELLED
}

enum LpgSaleVariant {
  REFILL
  EMPTY_SHELL
  COMPLETE_SET
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum AuditAction {
  LOGIN
  LOGOUT
  SALE_CREATED
  SALE_COMPLETED
  SALE_RETURNED
  INVOICE_CREATED
  INVOICE_PAID
  STOCK_ADJUSTED
  STOCK_RESTOCKED
  DEVICE_REGISTERED
  DEVICE_APPROVED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  BRANCH_CREATED
  BRANCH_UPDATED
  TRANSFER_CREATED
  TRANSFER_CANCELLED
}

enum ExpenseCategory {
  FUEL
  UTILITIES
  REPAIRS
  MISCELLANEOUS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

// Updated: APPROVED and REJECTED removed; transfers now resolve per-item
enum TransferStatus {
  PENDING    // All items still pending
  PARTIAL    // Some items responded to, some still pending
  COMPLETED  // All items resolved (accepted or rejected)
  CANCELLED  // Sender cancelled before any item was accepted
}

enum TransferItemStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum LpgComponent {
  REFILL
  CYLINDER
}

enum CylinderStatus {
  FULL
  EMPTY
  IN_TRANSIT
  DAMAGED
}

enum CylinderCondition {
  GOOD
  FAIR
  DAMAGED
}

// NEW: tracks every login attempt with location info
enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
  SUSPICIOUS
}

enum NotificationType {
  DEVICE_AUTH
  RETURN_REQUEST
  INVOICE_CREATED
  TRANSFER_REQUEST    // Receiving branch notified of incoming transfer
  TRANSFER_SENT       // Sending branch confirmation
  TRANSFER_RESPONSE   // Sending branch notified of per-item response
  TRANSFER_CANCELLED
  EXPENSE_SUBMITTED
  TRANSFER_APPROVED   // kept for migration compatibility
  TRANSFER_REJECTED   // kept for migration compatibility
  RETURN_APPROVED
  RETURN_REJECTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  LOW_STOCK
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum PaymentProvider {
  CASH
  MPESA
  BANK
}

enum MovementType {
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  RESTOCK
  ADJUSTMENT
  OPENING
}

// ==================== MODELS ====================

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole
  status    UserStatus @default(ACTIVE)

  branchId      String?
  branch        Branch? @relation("BranchUsers", fields: [branchId], references: [id])
  managedBranch Branch? @relation("BranchManager")

  lastLoginAt DateTime?

  devices             Device[]
  sales               Sale[]
  invoices            Invoice[]
  returns             Return[]
  auditLogs           AuditLog[]
  expenses            Expense[]
  transfersInitiated  Transfer[]           @relation("InitiatedBy")
  approvedDevices     Device[]             @relation("ApprovedBy")
  approvedReturns     Return[]             @relation("ReturnApprovedBy")
  approvedExpenses    Expense[]            @relation("ExpenseApprovedBy")
  refillVerifications RefillVerification[] @relation("RefillVerifiedBy")
  notifications       Notification[]       @relation("UserNotifications")
  stockAdjustments    StockAdjustment[]
  stockMovements      StockMovement[]
  branchClosings      BranchClosing[]
  loginLocations      LoginLocation[]      // NEW

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Device {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprint String       @unique
  name        String?
  status      DeviceStatus @default(PENDING)

  requestCode       String?
  requestCodeExpiry DateTime?

  approvedById String?
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  // ── NEW: login-attempt location (populated when device request is created) ──
  loginIpAddress String?
  loginLatitude  Float?
  loginLongitude Float?
  loginCity      String?
  loginRegion    String?
  loginCountry   String?
  // ──────────────────────────────────────────────────────────────────────────

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("devices")
}

model Branch {
  id      String  @id @default(uuid())
  name    String
  code    String  @unique
  address String
  phone   String
  email   String?

  managerId String? @unique
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id])

  users               User[]               @relation("BranchUsers")
  inventory           Inventory[]
  sales               Sale[]
  invoices            Invoice[]
  expenses            Expense[]
  transfersFrom       Transfer[]           @relation("TransferFromBranch")
  transfersTo         Transfer[]           @relation("TransferToBranch")
  dailySummaries      DailySalesSummary[]
  refillVerifications RefillVerification[]
  branchClosings      BranchClosing[]
  branchLocation      BranchLocation?      // NEW: geofence config
  cylinders           Cylinder[]           // NEW

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product_categories")
}

model Product {
  id          String          @id @default(uuid())
  name        String
  code        String          @unique
  description String?
  type        ProductType

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  price      Decimal  @db.Decimal(10, 2)
  emptyPrice Decimal? @db.Decimal(10, 2)
  costPrice  Decimal? @db.Decimal(10, 2)

  cylinderSize      String?
  brand             String?
  isCylinderTracked Boolean @default(false)

  // LPG component flags (NEW)
  isLpg       Boolean @default(false)
  hasCylinder Boolean @default(false)
  hasRefill   Boolean @default(false)

  minStockLevel Int @default(10)

  inventory     Inventory[]
  saleItems     SaleItem[]
  transferItems TransferItem[]
  cylinders     Cylinder[]     // NEW

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Inventory {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity        Int @default(0)
  fullCylinders   Int?
  minimumQuantity Int @default(10)

  totalRefilled Int @default(0)
  totalSold     Int @default(0)

  lastRestocked DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockAdjustments StockAdjustment[]
  stockMovements   StockMovement[]

  @@unique([branchId, productId])
  @@map("inventory")
}

model Customer {
  id    String  @id @default(uuid())
  name  String
  phone String  @unique
  email String?

  address String?
  notes   String?

  totalPurchases Decimal @default(0) @db.Decimal(10, 2)
  creditLimit    Decimal @default(0) @db.Decimal(10, 2)
  creditUsed     Decimal @default(0) @db.Decimal(10, 2)

  sales    Sale[]
  invoices Invoice[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Sale {
  id String @id @default(uuid())

  saleCode String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   SaleType
  status SaleStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paymentProvider PaymentProvider @default(CASH)
  mpesaRef        String?

  notes String?

  saleItems SaleItem[]
  returns   Return[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  lpgVariant LpgSaleVariant?

  @@map("sale_items")
}

model Invoice {
  id String @id @default(uuid())

  invoiceCode String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  status InvoiceStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  amountPaid Decimal @default(0) @db.Decimal(10, 2)
  balance    Decimal @db.Decimal(10, 2)

  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model Return {
  id String @id @default(uuid())

  returnCode String @unique

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  branchId String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ReturnApprovedBy", fields: [approvedById], references: [id])

  status ReturnStatus @default(PENDING)

  reason         String
  rejectionReason String?

  refundAmount Decimal @db.Decimal(10, 2)

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("returns")
}

model Expense {
  id String @id @default(uuid())

  expenseCode String @unique

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  approvedById String?
  approvedBy   User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  status      ExpenseStatus   @default(PENDING)

  rejectionReason String?
  receiptUrl      String?

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("expenses")
}

// ── Transfer (updated: per-item approval, no APPROVED/REJECTED top-level status) ──

model Transfer {
  id           String @id @default(uuid())
  transferCode String @unique // kept in DB for audit; hidden in UI

  fromBranchId String
  fromBranch   Branch @relation("TransferFromBranch", fields: [fromBranchId], references: [id])

  toBranchId String
  toBranch   Branch @relation("TransferToBranch", fields: [toBranchId], references: [id])

  requestedById String
  requestedBy   User   @relation("InitiatedBy", fields: [requestedById], references: [id])

  // Derived from item statuses: PENDING → PARTIAL → COMPLETED or CANCELLED
  status TransferStatus @default(PENDING)

  notes       String?
  respondedAt DateTime?

  items TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([createdAt])
  @@map("transfers")
}

model TransferItem {
  id         String   @id @default(uuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  // Each item has its own status — this is the core of per-item approval
  status TransferItemStatus @default(PENDING)

  // LPG-specific (null for non-LPG products)
  lpgComponent LpgComponent?
  cylinderId   String?
  cylinder     Cylinder?     @relation(fields: [cylinderId], references: [id])

  // Rejection note or any extra info from the receiver
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transferId])
  @@index([productId])
  @@index([status])
  @@map("transfer_items")
}

// ── NEW: Cylinder tracking ────────────────────────────────────────────────────

model Cylinder {
  id           String            @id @default(uuid())
  serialNumber String            @unique
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  status       CylinderStatus    @default(FULL)
  condition    CylinderCondition @default(GOOD)

  transferItems TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([branchId])
  @@index([status])
  @@map("cylinders")
}

// ── NEW: Geolocation models ───────────────────────────────────────────────────

model LoginLocation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Browser GPS coords (null if user denied)
  latitude  Float?
  longitude Float?
  accuracy  Float?

  // IP-based fallback enrichment
  ipAddress String?
  city      String?
  region    String?
  country   String?
  timezone  String?

  // Device info
  userAgent  String?
  deviceType String?

  isSuspicious Boolean     @default(false)
  blockReason  String?
  status       LoginStatus @default(SUCCESS)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([isSuspicious])
  @@map("login_locations")
}

model BranchLocation {
  id       String @id @default(uuid())
  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  latitude     Float
  longitude    Float
  radiusMeters Int   @default(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branch_locations")
}

// ── Existing models below (unchanged) ────────────────────────────────────────

model RefillVerification {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  expectedQuantity Int
  actualQuantity   Int
  verifiedQuantity Int?
  variance         Int @default(0)

  verifiedById String?
  verifiedBy   User?   @relation("RefillVerifiedBy", fields: [verifiedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refill_verifications")
}

model StockMovement {
  id String @id @default(uuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  type     MovementType
  quantity Int

  referenceId   String?
  referenceType String?

  notes String?

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@map("stock_movements")
}

model BranchClosing {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  date DateTime @db.Date

  openingCash  Decimal @db.Decimal(10, 2)
  cashSales    Decimal @db.Decimal(10, 2)
  mpesaSales   Decimal @db.Decimal(10, 2)
  totalExpenses Decimal @db.Decimal(10, 2)
  closingCash  Decimal @db.Decimal(10, 2)
  expectedCash Decimal @db.Decimal(10, 2)
  variance     Decimal @db.Decimal(10, 2)

  notes String?

  submittedById String?
  submittedBy   User?   @relation(fields: [submittedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, date])
  @@map("branch_closings")
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ActivityFeed {
  id String @id @default(uuid())

  type    String
  title   String
  message String

  entityId   String?
  entityType String?

  branchId String?

  metadata Json?

  visibleToBranch Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("activity_feed")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  entityType String
  entityId   String?

  oldValues   Json?
  newValues   Json?
  description String

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  actionUrl String?

  userId String?
  user   User?   @relation("UserNotifications", fields: [userId], references: [id])

  entityId   String?
  entityType String?

  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model StockAdjustment {
  id String @id @default(uuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  type     String
  quantity Int
  reason   String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("stock_adjustments")
}

model DailySalesSummary {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  date DateTime @db.Date

  totalSales    Decimal @db.Decimal(10, 2)
  cashSales     Decimal @db.Decimal(10, 2)
  mpesaSales    Decimal @db.Decimal(10, 2)
  invoiceSales  Decimal @db.Decimal(10, 2)
  totalExpenses Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([branchId, date])
  @@map("daily_sales_summaries")
}
